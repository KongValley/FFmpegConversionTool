{
  "name": "media-converter",
  "version": "0.5.0",
  "private": true,
  "description": "音视频转换工具（Electron + FFmpeg，NVENC 硬件加速）",
  "author": "KongValley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KongValley/FFmpegConversionTool.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:publish": "electron-vite build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
